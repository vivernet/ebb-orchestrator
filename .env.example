# Необязательная локальная конфигурация Ebb Orchestrator.
# Пустое значение использует каталог пользователя по умолчанию.
EBB_ORCHESTRATOR_HOME=
# Windows: EBB_ORCHESTRATOR_HOME=C:/Users/your-name/.ebb-orchestrator
# macOS: EBB_ORCHESTRATOR_HOME=/Users/your-name/.ebb-orchestrator
# Linux: EBB_ORCHESTRATOR_HOME=/home/your-name/.ebb-orchestrator
PORT=3000
