  "gates": {
    "requiredPlatforms": [
      {
        "id": "quality-security-ubuntu-node24",
        "platform": "ubuntu-24.04",
        "node": "24.x",
        "status": "configured",
        "requiredChecks": [
          "pnpm lint",
          "pnpm typecheck",
          "pnpm test",
          "pnpm server:build",
          "node scripts/local-user-stdin-smoke.mjs",
          "pnpm web:build",
          "node --test scripts/security-audit-evidence.test.mjs apps/web/test/e2e/credential-handoff.test.mjs",
          "dependency audit (security-audit-evidence.mjs)",
          "git diff --check",
          "Playwright Chromium/browser E2E"
        ]
      },
      {
        "id": "native-windows-node24",
        "platform": "windows-latest",
        "node": "24.x",
        "status": "configured",
        "requiredChecks": [
          "pnpm --filter @ebb-orchestrator/server build:windows-run-supervisor",
          "native process-scope acceptance (EBB_RUN_NATIVE_SCOPE_ACCEPTANCE=1)"
        ]
      },
      {
        "id": "native-linux-node24-selfhosted",
        "platform": "self-hosted",
        "runtimeLabels": ["self-hosted", "Linux", "X64", "ebb-systemd-cgroup-v2"],
        "node": "24.x",
        "status": "blocked",
        "blocker": "BLOCKED_SELF_HOSTED_RUNNER: repo has 0 registered runners; no self-hosted/ebb-systemd-cgroup-v2 labels in workflows; Linux native acceptance currently push-only on hosted ubuntu-24.04",
        "producerTask": "Task8",
        "requiredChecks": ["native process-scope acceptance"]
      },
      {
        "id": "keyring-linux-windows-node24",
        "platform": "matrix ubuntu-latest/windows-latest",
        "node": "24.x",
        "status": "configured",
        "requiredChecks": [
          "node --test scripts/keyring-acceptance.test.mjs",
          "pnpm exec tsx apps/server/scripts/keyring-smoke.ts"
        ]
      },
      {
        "id": "codeql-ubuntu",
        "platform": "ubuntu-latest",
        "status": "configured",
        "requiredChecks": ["CodeQL analyze (JavaScript/TypeScript, build-mode none)"]
      },
      {
        "id": "governance-release-docker",
        "platform": "docker",
        "status": "blocked",
        "blocker": "BLOCKED_DOCKER_DEPENDENCY: zero Dockerfile/compose/GHCR/docker-action references in repo or workflows; release image path has no basis yet",
        "producerTask": "Task9",
        "requiredChecks": [
          "configured image/platform build+smoke",
          "version/labels/digests/public metadata",
          "every release module/CLI regression"
        ]
      }
    ]
  },
