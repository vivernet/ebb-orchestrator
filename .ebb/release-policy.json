  "versionEncoding": {
    "kind": "semver",
    "stableOnly": true,
    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
    "allowPrerelease": false,
    "allowBuildMetadata": false,
    "note": "stable MAJOR.MINOR.PATCH only; prerelease/build metadata and suffixes forbidden"
