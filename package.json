{
  "name": "ebb-orchestrator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm server:build && pnpm -r --workspace-concurrency=1 --if-present test && node --test scripts/server-env.test.mjs scripts/run-server.test.mjs scripts/local-user-stdin-smoke.test.mjs scripts/plan06-project-config-restart-acceptance.test.mjs scripts/plan06-github-inbox-restart-acceptance.test.mjs scripts/hermes-session-tag-acceptance.test.mjs scripts/build-windows-msvc-environment.test.mjs",
    "lint": "eslint .",
    "build": "pnpm -r --if-present build",
    "server:build": "pnpm --filter @ebb-orchestrator/server build",
    "plan01:acceptance": "pnpm server:build && node scripts/plan01-process-recovery-acceptance.mjs",
    "plan05:epic-restart:acceptance": "pnpm server:build && node scripts/plan05-epic-restart-acceptance.mjs",
    "plan06:project-config:acceptance": "pnpm server:build && node scripts/plan06-project-config-restart-acceptance.mjs",
    "plan06:github-inbox:acceptance": "pnpm server:build && node scripts/plan06-github-inbox-restart-acceptance.mjs",
    "hermes:session-tag:acceptance": "node scripts/hermes-session-tag-acceptance.mjs",
    "web:build": "pnpm --filter @ebb-orchestrator/web build",
    "hermes:setup": "node scripts/hermes-dev.mjs setup",
    "hermes:check": "node scripts/hermes-dev.mjs check",
    "hermes:test": "node --test scripts/hermes-dev.test.mjs",
    "skills:test": "node --test scripts/ebb-skills.test.mjs",
    "skills:dependencies:test": "node --test scripts/ebb-skill-dependencies.test.mjs",
    "hermes:execute": "node scripts/hermes-dev.mjs execute",
    "docs:inventory": "node scripts/docs-governance.mjs inventory",
    "docs:check": "node scripts/docs-governance.mjs check",
    "docs:roadmap": "node scripts/roadmap-generator-cli.mjs",
    "docs:rename:check": "node scripts/docs-governance.mjs rename:check",
    "docs:link:sync": "node scripts/docs-governance.mjs link:sync",
    "docs:test": "node --test scripts/docs-governance.test.mjs",
    "start": "node scripts/run-server.js",
    "server:dev": "node scripts/run-server.js dev",
    "web:dev": "pnpm --filter @ebb-orchestrator/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "64.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  }
}
