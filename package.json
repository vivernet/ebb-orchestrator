{
  "name": "ebb-orchestrator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "build": "pnpm -r --if-present build",
    "server:build": "pnpm --filter @ebb-orchestrator/server build",
    "web:build": "pnpm --filter @ebb-orchestrator/web build",
    "hermes:setup": "node scripts/hermes-dev.mjs setup",
    "hermes:check": "node scripts/hermes-dev.mjs check",
    "hermes:test": "node --test scripts/hermes-dev.test.mjs",
    "hermes:execute": "node scripts/hermes-dev.mjs execute",
    "docs:inventory": "node scripts/docs-governance.mjs inventory",
    "docs:check": "node scripts/docs-governance.mjs check",
    "docs:roadmap": "node scripts/roadmap-generator-cli.mjs",
    "docs:rename:check": "node scripts/docs-governance.mjs rename:check",
    "docs:link:sync": "node scripts/docs-governance.mjs link:sync",
    "docs:test": "node --test scripts/docs-governance.test.mjs",
    "start": "node apps/server/dist/main.js",
    "server:dev": "pnpm --filter @ebb-orchestrator/server dev",
    "web:dev": "pnpm --filter @ebb-orchestrator/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "64.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  }
}
