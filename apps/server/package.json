{
  "name": "@ebb-orchestrator/server",
  "private": true,
  "bin": {
    "ebb-orchestrator-mcp": "src/bin/ebb-orchestrator-mcp.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-server.js dev",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "pnpm --filter @ebb-orchestrator/contracts build && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "build:windows-run-supervisor": "node scripts/build-windows-run-supervisor.mjs",
    "start": "node ../../scripts/run-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:auth-contract": "vitest run test/platform/security/auth-onboarding-contract.test.ts test/platform/security/password-hash-feasibility.test.ts"
  },
  "dependencies": {
    "@ebb-orchestrator/contracts": "workspace:*",
    "@ebb-orchestrator/testing": "workspace:*",
    "@infisical/sdk": "^5.0.2",
    "@napi-rs/keyring": "2.1.0",
    "argon2": "0.45.1",
    "fastify": "^5.12.4",
    "js-yaml": "^5.4.2",
    "zod": "^4.6.0"
  }
}
