{
  "$schema": "https://json.schemastore.org/scan-manifest.json",
  "schemaVersion": 1,
  "project": "ebb-orchestrator",
  "repository": {
    "branch": "develop",
    "mainBranch": "master",
    "sourceRoots": ["apps", "packages", "scripts"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.mjs",
    "**/package.json",
    "**/pnpm-lock.yaml",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml"
  ],
  "exclude": [
    "node_modules/**",
    "**/dist/**",
    "**/.playwright/**",
    "**/coverage/**",
    "**/*.db",
    "**/*.db-*"
  ],
  "qualityGates": [
    "pnpm lint",
    "pnpm typecheck",
    "pnpm test",
    "pnpm server:build",
    "pnpm web:build",
    "pnpm --dir apps/web test:e2e"
  ],
  "securityGates": [
    {
      "command": "pnpm audit --prod --json",
      "purpose": "dependency-vulnerability-audit",
      "required": true,
      "result": "must-complete-in-release-runner"
    },
    {
      "command": "git diff --check",
      "purpose": "repository-integrity",
      "required": true,
      "result": "must-be-clean"
    }
  ],
  "scanner": {
    "provider": "pnpm",
    "tool": "pnpm audit --prod --json",
    "version": null,
    "lastRun": null,
    "artifactPattern": "artifacts/security/pnpm-audit-prod-{revision}.json",
    "result": "requires-ci-run",
    "revision": null,
    "lockfileSha256": null,
    "exitCode": null,
    "provenanceFields": ["revision", "branch", "lockfileSha256", "runAt", "exitCode"]
  },
  "secretPolicy": {
    "failOnTrackedEnvFiles": true,
    "allowExampleEnvFiles": true,
    "redactFindings": true
  }
}
